# LLM — init_chat_model("openai:gpt-4o-mini") reads OPENAI_API_KEY
LLM_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=

# Comma-separated UI origins (local dev + deployed MVP-UI)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Render persistent disk mount path, e.g. /var/data/chroma
# CHROMA_DIR=

# Supabase Postgres — Project Settings → Database → Connection string (URI)
# If the password contains @ : / ? # encode it (e.g. @ → %40)
# Use Session pooler URI (port 5432) on IPv4-only networks.
DATABASE_URL=
